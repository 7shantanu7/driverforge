@PACKAGE_INIT@

# Generated by CMake. Consumers write:
#   find_package(gpu_driver_stack 1.0 REQUIRED CONFIG)
#   target_link_libraries(app PRIVATE gpu_driver_stack::gpu_core)
include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/gpu_driver_stackTargets.cmake")
# Present only when the -tools package (shader_compiler) is installed.
include("${CMAKE_CURRENT_LIST_DIR}/gpu_driver_stackToolsTargets.cmake" OPTIONAL)

# Where the driver plugins were installed, and which SOVERSION to load.
set_and_check(gpu_driver_stack_PLUGIN_DIR "@PACKAGE_GPU_STACK_PLUGIN_INSTALL_DIR@")
set(gpu_driver_stack_PLUGIN_SOVERSION @GPU_STACK_PLUGIN_SOVERSION@)

check_required_components(gpu_driver_stack)
