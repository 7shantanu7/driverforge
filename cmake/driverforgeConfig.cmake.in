@PACKAGE_INIT@

# Generated by CMake. Consumers write:
#   find_package(driverforge 1.0 REQUIRED CONFIG)
#   target_link_libraries(app PRIVATE driverforge::gpu_core)
include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/driverforgeTargets.cmake")
# Present only when the -tools package (shader_compiler) is installed.
include("${CMAKE_CURRENT_LIST_DIR}/driverforgeToolsTargets.cmake" OPTIONAL)

# Where the driver plugins were installed, and which SOVERSION to load.
set_and_check(driverforge_PLUGIN_DIR "@PACKAGE_DRIVERFORGE_PLUGIN_INSTALL_DIR@")
set(driverforge_PLUGIN_SOVERSION @DRIVERFORGE_PLUGIN_SOVERSION@)

check_required_components(driverforge)
